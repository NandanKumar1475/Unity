using UnityEngine;
using Whisper.Samples;
using System.Text.RegularExpressions;

public class VoiceCommandController_AI : MonoBehaviour
{
    [Header("Voice Source")]
    public StreamingSampleMic mic;

    [Header("Target")]
    public Transform target;

    [Header("Movement")]
    public float moveSpeed = 2.5f;
    public float moveSmooth = 6f;

    [Header("Rotation")]
    public float rotateSpeed = 120f;
    public float rotateSmooth = 6f;

    [Header("Reset")]
    public float resetSpeed = 2f;

    [Header("Wake Word")]
    public string wakeWord = "hey";

    Vector3 originPos;
    Quaternion originRot;

    Vector3 targetMoveVelocity;
    Vector3 currentMoveVelocity;

    Vector3 targetAngularVelocity;
    Vector3 currentAngularVelocity;

    float moveTimer;
    float rotateTimer;

    bool resetPos, resetRot;
    Vector3 resetPosStart;
    Quaternion resetRotStart;
    float resetT;

    bool wakeActive;

    void Awake()
    {
        originPos = target.position;
        originRot = target.rotation;
    }

    void OnEnable()
    {
        mic.OnFinalText += HandleCommand;
    }

    void OnDisable()
    {
        mic.OnFinalText -= HandleCommand;
    }

    void Update()
    {
        HandleMove();
        HandleRotate();
        HandleReset();
    }

    // ================= VOICE =================

    void HandleCommand(string text)
    {
        text = text.ToLower().Trim();
        Debug.Log("VOICE: " + text);

        if (text.Contains(wakeWord))
        {
            wakeActive = true;
            return;
        }

        if (!wakeActive) return;

        if (text.Contains("stop"))
        {
            StopAll();
            return;
        }

        if (text.Contains("reset position"))
        {
            StartResetPosition();
            return;
        }

        if (text.Contains("reset rotation"))
        {
            StartResetRotation();
            return;
        }

        HandleSpeedChange(text);

        float duration = ExtractDuration(text);
        VoiceAction action = GetAction(text);
        VoiceDirection dir = GetDirection(text);

        if (action == VoiceAction.Move && dir != VoiceDirection.None)
        {
            targetMoveVelocity = GetDirectionVector(dir) * moveSpeed;
            moveTimer = duration;
        }

        if (action == VoiceAction.Rotate && dir != VoiceDirection.None)
        {
            targetAngularVelocity = GetRotationAxis(dir) * rotateSpeed;
            rotateTimer = duration;
        }
    }

    // ================= MOVE =================

    void HandleMove()
    {
        if (moveTimer <= 0f)
        {
            targetMoveVelocity = Vector3.zero;
            return;
        }

        moveTimer -= Time.deltaTime;

        currentMoveVelocity = Vector3.Lerp(
            currentMoveVelocity,
            targetMoveVelocity,
            moveSmooth * Time.deltaTime
        );

        target.position += currentMoveVelocity * Time.deltaTime;
    }

    // ================= ROTATE =================

    void HandleRotate()
    {
        if (rotateTimer <= 0f)
        {
            targetAngularVelocity = Vector3.zero;
            return;
        }

        rotateTimer -= Time.deltaTime;

        currentAngularVelocity = Vector3.Lerp(
            currentAngularVelocity,
            targetAngularVelocity,
            rotateSmooth * Time.deltaTime
        );

        target.Rotate(currentAngularVelocity * Time.deltaTime, Space.World);
    }

    // ================= RESET =================

    void StartResetPosition()
    {
        resetPos = true;
        resetRot = false;
        resetT = 0f;
        resetPosStart = target.position;
    }

    void StartResetRotation()
    {
        resetRot = true;
        resetPos = false;
        resetT = 0f;
        resetRotStart = target.rotation;
    }

    void HandleReset()
    {
        if (resetPos)
        {
            resetT += Time.deltaTime * resetSpeed;
            target.position = Vector3.Lerp(resetPosStart, originPos, resetT);
            if (resetT >= 1f) resetPos = false;
        }

        if (resetRot)
        {
            resetT += Time.deltaTime * resetSpeed;
            target.rotation = Quaternion.Slerp(resetRotStart, originRot, resetT);
            if (resetT >= 1f) resetRot = false;
        }
    }

    void StopAll()
    {
        targetMoveVelocity = Vector3.zero;
        targetAngularVelocity = Vector3.zero;
        currentMoveVelocity = Vector3.zero;
        currentAngularVelocity = Vector3.zero;
        moveTimer = 0f;
        rotateTimer = 0f;
        Debug.Log("STOPPED");
    }

    // ================= AI PARSING =================

    float ExtractDuration(string t)
    {
        Match m = Regex.Match(t, @"(\d+(\.\d+)?)\s*(second|seconds)");
        if (m.Success)
            return float.Parse(m.Groups[1].Value);
        return 1.5f; // default duration
    }

    void HandleSpeedChange(string t)
    {
        if (t.Contains("faster"))
            moveSpeed += 1f;

        if (t.Contains("slower"))
            moveSpeed = Mathf.Max(0.5f, moveSpeed - 1f);

        Match m = Regex.Match(t, @"speed\s*(\d+(\.\d+)?)");
        if (m.Success)
            moveSpeed = float.Parse(m.Groups[1].Value);
    }

    VoiceAction GetAction(string t)
    {
        if (t.Contains("move") || t.Contains("go")) return VoiceAction.Move;
        if (t.Contains("rotate") || t.Contains("turn")) return VoiceAction.Rotate;
        return VoiceAction.None;
    }

    VoiceDirection GetDirection(string t)
    {
        if (t.Contains("left")) return VoiceDirection.Left;
        if (t.Contains("right")) return VoiceDirection.Right;
        if (t.Contains("forward")) return VoiceDirection.Forward;
        if (t.Contains("back")) return VoiceDirection.Backward;
        if (t.Contains("up")) return VoiceDirection.Up;
        if (t.Contains("down")) return VoiceDirection.Down;
        return VoiceDirection.None;
    }

    Vector3 GetDirectionVector(VoiceDirection d)
    {
        return d switch
        {
            VoiceDirection.Left => Vector3.left,
            VoiceDirection.Right => Vector3.right,
            VoiceDirection.Forward => Vector3.forward,
            VoiceDirection.Backward => Vector3.back,
            VoiceDirection.Up => Vector3.up,
            VoiceDirection.Down => Vector3.down,
            _ => Vector3.zero
        };
    }

    Vector3 GetRotationAxis(VoiceDirection d)
    {
        return d switch
        {
            VoiceDirection.Left => Vector3.up * -1,
            VoiceDirection.Right => Vector3.up,
            VoiceDirection.Up => Vector3.right * -1,
            VoiceDirection.Down => Vector3.right,
            _ => Vector3.zero
        };
    }
}

public enum VoiceAction { None, Move, Rotate }
public enum VoiceDirection { None, Left, Right, Forward, Backward, Up, Down }
