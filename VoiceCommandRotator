using System.Collections;
using System.Collections.Concurrent;
using UnityEngine;
using Whisper.Utils;

namespace Whisper.Samples
{
    public class VoiceCommandRotator : MonoBehaviour
    {
        [Header("Stream")]
        public WhisperManager whisper;            // required if SubscribeExistingStream = false
        public MicrophoneRecord microphoneRecord; // required if SubscribeExistingStream = false
        public WhisperStream existingStream;      // assign if you want to subscribe to an already-created stream

        [Header("Behavior")]
        public bool subscribeExistingStream = true; // set true to reuse an existing stream (preferred)
        public Transform target;
        public float stepAngle = 90f;
        public float rotateDuration = 0.45f;

        private readonly ConcurrentQueue<float> _angles = new ConcurrentQueue<float>();
        private readonly ConcurrentQueue<string> _incoming = new ConcurrentQueue<string>();
        private WhisperStream _stream;
        private bool _isRotating;

        async void Start()
        {
            if (subscribeExistingStream)
            {
                _stream = existingStream;
                if (_stream != null)
                    _stream.OnResultUpdated += OnResultReceived;
                // if existingStream not assigned, the script stays quiet and only responds to InjectCommand
                return;
            }

            if (whisper == null || microphoneRecord == null) return;
            _stream = await whisper.CreateStream(microphoneRecord);
            if (_stream != null) _stream.OnResultUpdated += OnResultReceived;
        }

        void OnResultReceived(string text)
        {
            if (string.IsNullOrWhiteSpace(text)) return;
            _incoming.Enqueue(text);
        }

        void Update()
        {
            while (_incoming.TryDequeue(out var txt))
            {
                var lower = txt.ToLowerInvariant().Trim();
                // match whole words to avoid substrings triggers
                var words = lower.Split(' ', '\t', '\n', '\r', ',', '.', '!', '?');

                bool left = System.Array.Exists(words, w => w == "left");
                bool right = System.Array.Exists(words, w => w == "right");
                bool stop = System.Array.Exists(words, w => w == "stop");

                if (left) _angles.Enqueue(-Mathf.Abs(stepAngle));
                else if (right) _angles.Enqueue(Mathf.Abs(stepAngle));
                else if (stop)
                {
                    // clear pending rotations
                    while (_angles.TryDequeue(out _)) { }
                }
                // otherwise ignore silently
            }

            if (!_isRotating && _angles.TryDequeue(out var angle))
            {
                StartCoroutine(RotateOnce(angle));
            }
        }

        IEnumerator RotateOnce(float angle)
        {
            _isRotating = true;
            var start = target.rotation;
            var end = start * Quaternion.Euler(0, angle, 0);
            float t = 0f;
            while (t < rotateDuration)
            {
                t += Time.deltaTime;
                target.rotation = Quaternion.Slerp(start, end, Mathf.Clamp01(t / rotateDuration));
                yield return null;
            }
            target.rotation = end;
            _isRotating = false;
            Debug.Log($"COMMAND EXECUTED: rotated {(angle < 0 ? "LEFT" : "RIGHT")}");
        }

        public void InjectCommand(string cmd)
        {
            if (string.IsNullOrWhiteSpace(cmd)) return;
            var lower = cmd.ToLowerInvariant().Trim();
            if (lower == "left") _angles.Enqueue(-Mathf.Abs(stepAngle));
            else if (lower == "right") _angles.Enqueue(Mathf.Abs(stepAngle));
            else if (lower == "stop") while (_angles.TryDequeue(out _)) { }
        }

        void OnDestroy()
        {
            if (_stream != null) _stream.OnResultUpdated -= OnResultReceived;
        }
    }
}
