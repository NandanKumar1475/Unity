    void SetUniformWorldScale(Transform child, float desiredWorldSize)
    {
        if (child == null) return;
        Transform parent = child.parent;
        if (parent == null)
        {
            child.localScale = Vector3.one * desiredWorldSize;
            return;
        }

        Vector3 lossy = parent.lossyScale;
        float maxParentScale = Mathf.Max(Mathf.Abs(lossy.x), Mathf.Abs(lossy.y), Mathf.Abs(lossy.z));
        if (maxParentScale <= 1e-5f) maxParentScale = 1f;
        float local = desiredWorldSize / maxParentScale;
        child.localScale = Vector3.one * local;
    }

    Bounds ComputeBoundsOfChildren(Transform root)
    {
        if (root == null) return new Bounds(Vector3.zero, Vector3.one * 0.1f);

        var renderers = root.GetComponentsInChildren<Renderer>(true);
        var psRenderers = root.GetComponentsInChildren<ParticleSystemRenderer>(true);

        List<Renderer> all = new List<Renderer>();
        if (renderers != null) all.AddRange(renderers);
        if (psRenderers != null)
        {
            foreach (var psr in psRenderers) if (psr != null) all.Add(psr);
        }

        if (all.Count > 0)
        {
            Bounds b = all[0].bounds;
            for (int i = 1; i < all.Count; i++)
            {
                if (all[i] == null) continue;
                try { b.Encapsulate(all[i].bounds); } catch { }
            }

            Vector3 minSize = Vector3.one * Mathf.Max(0.2f, desiredNucleusScale * 0.8f);
            if (b.size.x < minSize.x || b.size.y < minSize.y || b.size.z < minSize.z)
            {
                Vector3 center = b.center;
                b = new Bounds(center, Vector3.Max(b.size, minSize));
            }

            return b;
        }

        var children = root.GetComponentsInChildren<Transform>(true);
        if (children != null && children.Length > 0)
        {
            Vector3 min = children[0].position;
            Vector3 max = children[0].position;
            foreach (var t in children)
            {
                if (t == null) continue;
                min = Vector3.Min(min, t.position);
                max = Vector3.Max(max, t.position);
            }
            Vector3 size = max - min;
            Vector3 minSize = Vector3.one * Mathf.Max(0.2f, desiredNucleusScale * 0.8f);
            size = Vector3.Max(size, minSize);
            Vector3 centerPos = (min + max) * 0.5f;
            return new Bounds(centerPos, size);
        }

        return new Bounds(root.position, Vector3.one * Mathf.Max(0.2f, desiredNucleusScale * 0.8f));
    }

    void AdjustCameraToFitBounds(Camera cam, Bounds bounds, float padding = 1.1f)
    {
        if (cam == null) return;
        if (bounds.size == Vector3.zero) return;

        float radius = bounds.extents.magnitude * padding;

        float minRadius = Mathf.Max(1f, desiredNucleusScale * 1.5f);
        radius = Mathf.Max(radius, minRadius);

        if (cam.orthographic)
        {
            cam.orthographicSize = radius;
            cam.transform.LookAt(bounds.center);
            return;
        }

        float fov = cam.fieldOfView * Mathf.Deg2Rad;
        float neededDistance = radius / Mathf.Sin(fov * 0.5f);

        Vector3 dirToCamera = (cam.transform.position - bounds.center).normalized;
        if (dirToCamera == Vector3.zero) dirToCamera = -cam.transform.forward;

        Vector3 newCamPos = bounds.center + dirToCamera * Mathf.Max(neededDistance, minRadius * 0.9f);

        cam.transform.position = newCamPos;
        cam.transform.LookAt(bounds.center);
    }

