    // --------------------------
    // COVALENT FX – midpoint between atoms
    // --------------------------
    private void SpawnLoopingCovalentFXBetween(GameObject aGO, GameObject bGO, BondType bondType, int bonds = 1)
    {
        if (covalentBond == null || aGO == null || bGO == null) return;

        Vector3 pa = aGO.transform.position + Vector3.up * 0.2f;
        Vector3 pb = bGO.transform.position + Vector3.up * 0.2f;
        Vector3 dir = (pb - pa).normalized;
        if (dir == Vector3.zero) dir = Vector3.right;

        Vector3 perp = Vector3.Cross(dir, Vector3.up).normalized;
        if (perp == Vector3.zero) perp = Vector3.right;

        float fxSpacing = 0.15f;
        GameObject fxRoot = EnsureFXRoot();

        for (int i = 0; i < bonds; i++)
        {
            float offset = (i - (bonds - 1) * 0.5f) * fxSpacing;
            Vector3 mid = (aGO.transform.position + bGO.transform.position) * 0.5f
                          + Vector3.up * 0.45f
                          + perp * offset;

            GameObject fxInst = CreateFromPool("CovalentFX", covalentBond, fxRoot.transform);

            fxInst.transform.position = new Vector3(-8f, 0f, 316f);
            try { fxInst.transform.forward = dir; } catch { }

            PrepareFXInstance(fxInst, enforceLoop: true);

            var pss = fxInst.GetComponentsInChildren<ParticleSystem>(true);
            if (bondType == BondType.PolarCovalent)
            {
                Color polarColor = new Color(1f, 0.75f, 0.35f);
                foreach (var ps in pss)
                {
                    if (ps == null) continue;
                    try
                    {
                        var main = ps.main;
                        main.startColor = new ParticleSystem.MinMaxGradient(polarColor);
                    }
                    catch { }
                }
            }
            else
            {
                Color nonPolarColor = new Color(0.9f, 0.95f, 1f);
                foreach (var ps in pss)
                {
                    if (ps == null) continue;
                    try
                    {
                        var main = ps.main;
                        main.startColor = new ParticleSystem.MinMaxGradient(nonPolarColor);
                    }
                    catch { }
                }
            }

            if (!activeCovalentFX.Contains(fxInst)) activeCovalentFX.Add(fxInst);
        }
    }

    public void StopCovalentFX(GameObject fxInst, float fadeDelay = 0.5f)
    {
        if (fxInst == null) return;
        if (activeCovalentFX.Contains(fxInst)) activeCovalentFX.Remove(fxInst);

