    // --------------------------
    // Camera zoom pulse (zoom out -> zoom in -> settle)
    // --------------------------
    private IEnumerator CameraZoomPulse(Transform worldRoot, float outFactor = 0.5f, float inFactor = 0.9f, float settleDuration = 0.6f)
    {
        if (worldRoot == null || Camera.main == null) yield break;
        Camera cam = Camera.main;
        Bounds b = ComputeBoundsOfChildren(worldRoot);
        if (b.size == Vector3.zero) yield break;

        Vector3 center = b.center;
        Vector3 origPos = cam.transform.position;
        Quaternion origRot = cam.transform.rotation;

        // direction from bounds center to camera
        Vector3 dir = (origPos - center).normalized;
        if (dir == Vector3.zero) dir = -cam.transform.forward;

        float startDist = Vector3.Distance(origPos, center);

        // targets
        float outDist = startDist * (1f + Mathf.Abs(outFactor));    // zoom out (increase distance)
        float inDist = startDist * Mathf.Max(0.35f, inFactor);      // zoom in (closer than original)
        float durOut = 0.45f;
        float durIn = 0.55f;

        // OUT
        float elapsed = 0f;
        while (elapsed < durOut)
        {
            elapsed += Time.deltaTime;
            float t = Mathf.SmoothStep(0f, 1f, elapsed / durOut);
            float dist = Mathf.Lerp(startDist, outDist, t);
            cam.transform.position = center + dir * dist;
            cam.transform.LookAt(center);
            yield return null;
        }

        // IN (closer than original, brief)
        elapsed = 0f;
        while (elapsed < durIn)
        {
            elapsed += Time.deltaTime;
            float t = Mathf.SmoothStep(0f, 1f, elapsed / durIn);
            float dist = Mathf.Lerp(outDist, inDist, t);
            cam.transform.position = center + dir * dist;
            cam.transform.LookAt(center);
            yield return null;
        }

        // settle back to original smoothly
        elapsed = 0f;
        while (elapsed < settleDuration)
        {
            elapsed += Time.deltaTime;
            float t = Mathf.SmoothStep(0f, 1f, elapsed / settleDuration);
            cam.transform.position = Vector3.Lerp(center + dir * inDist, origPos, t);
            cam.transform.rotation = Quaternion.Slerp(cam.transform.rotation, origRot, t);
            yield return null;
        }

        cam.transform.position = origPos;
        cam.transform.rotation = origRot;
    }
