  for Text UI
  using TMPro;
using UnityEngine;

public class TextFader : MonoBehaviour
{
    public TMP_Text textToFade;

    public void StartFadeIn()
    {
        StartCoroutine(FadeInText(textToFade, 2f));
    }

    public void StartFadeOut()
    {
        StartCoroutine(FadeOutText(textToFade, 2f));
    }

    IEnumerator FadeInText(TMP_Text text, float duration)
    {
        Color c = text.color;
        c.a = 0f;
        text.color = c;

        float t = 0f;

        while (t < duration)
        {
            t += Time.deltaTime;
            float alpha = Mathf.Lerp(0f, 1f, t / duration);
            c.a = alpha;
            text.color = c;

            yield return null;
        }

        c.a = 1f;
        text.color = c;
    }

    IEnumerator FadeOutText(TMP_Text text, float duration)
    {
        Color c = text.color;
        c.a = 1f;
        text.color = c;

        float t = 0f;

        while (t < duration)
        {
            t += Time.deltaTime;
            float alpha = Mathf.Lerp(1f, 0f, t / duration);
            c.a = alpha;
            text.color = c;

            yield return null;
        }

        c.a = 0f;
        text.color = c;
    }
}
