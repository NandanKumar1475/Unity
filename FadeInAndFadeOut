  Fade Any UI (Panel, Image, Text) using CanvasGroup
  On your UI parent (Panel / object containing UI), add:
CanvasGroup component.
Use this script:
using UnityEngine;

public class UIFader : MonoBehaviour
{
    public CanvasGroup canvasGroup;

    public void FadeInUI(float duration)
    {
        StartCoroutine(FadeCanvasGroup(canvasGroup, 0f, 1f, duration));
    }

    public void FadeOutUI(float duration)
    {
        StartCoroutine(FadeCanvasGroup(canvasGroup, 1f, 0f, duration));
    }

    IEnumerator FadeCanvasGroup(CanvasGroup cg, float start, float end, float duration)
    {
        float t = 0f;

        cg.alpha = start;

        while (t < duration)
        {
            t += Time.deltaTime;
            cg.alpha = Mathf.Lerp(start, end, t / duration);
            yield return null;
        }

        cg.alpha = end;
    }
}
You can call:
FadeInUI(1.5f);
FadeOutUI(1.5f);

  
