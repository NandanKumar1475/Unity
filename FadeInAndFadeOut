  1.Fadding GameObject
      IEnumerator FadingNaCl(GameObject obj, float duration)
    {
        Renderer rend = obj.GetComponentInChildren<Renderer>();

        if (rend == null)
        {
            Debug.Log("No renderer found on solution object!");
            yield break;
        }

        // use instance of material
        Material mat = rend.material;

        // start fully transparent
        Color color = mat.color;
        color.a = 0f;
        mat.color = color;

        float t = 0f;

        while (t < duration)
        {
            t += Time.deltaTime;
            float alpha = Mathf.Lerp(0f, 1f, t / duration);

            color.a = alpha;
            mat.color = color;

            yield return null;
        }
    }

---------------------------------------------------------------------
Fade out the GameObject 

  IEnumerator FadeOut(GameObject obj, float duration)
{
    Renderer rend = obj.GetComponent<Renderer>();

    if (rend == null)
    {
        Debug.LogError("No Renderer found on object!");
        yield break;
    }

    Material mat = rend.material;
    Color c = mat.color;

    // make sure we start fully visible
    c.a = 1f;
    mat.color = c;

    float t = 0f;

    while (t < duration)
    {
        t += Time.deltaTime;

        // 1 → 0 as t goes from 0 → duration
        float alpha = Mathf.Lerp(1f, 0f, t / duration);

        c.a = alpha;
        mat.color = c;

        yield return null;
    }

    // ensure fully invisible at end
    c.a = 0f;
    mat.color = c;
}

-----------------------------------------------------------------------------
  FadeInAndFadeOut
  IEnumerator FadeInOut(GameObject obj, float fadeDuration, float waitTime)
{
    // Fade In
    yield return StartCoroutine(FadeIn(obj, fadeDuration));

    // Stay visible for some time
    yield return new WaitForSeconds(waitTime);

    // Fade Out
    yield return StartCoroutine(FadeOut(obj, fadeDuration));
}

